AGENT_OPENAI_API_KEY=your-api-key
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=Qwen/Qwen3-8B
AGENT_CLASSIFIER_MODEL=Qwen/Qwen3-8B
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
AGENT_RAG_RERANK_ENABLED=0
AGENT_RAG_RERANK_API_KEY=your-api-key
AGENT_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
AGENT_RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# 父子分块按字符计数；修改分块参数后须重启或受控重建索引。
AGENT_RAG_PARENT_SIZE=1600
AGENT_RAG_PARENT_OVERLAP=160
AGENT_RAG_CHILD_SIZE=420
AGENT_RAG_CHILD_OVERLAP=80
AGENT_RAG_PARENT_TOP_K=2
AGENT_RAG_EVIDENCE_CHAR_BUDGET=3200
AGENT_ECOMMERCE_BASE_URL=http://127.0.0.1:8081
AGENT_ECOMMERCE_SERVICE_TOKEN=replace-me
AGENT_FEEDBACK_STORE_PATH=.runtime/feedback_store.json
# 售后图快照与业务审批记录分开存储；相对路径按仓库根目录解析。
AGENT_WORKFLOW_CHECKPOINT_PATH=.runtime/after_sale_checkpoints.sqlite3
AGENT_WORKFLOW_APPROVAL_STORE_PATH=.runtime/after_sale_approvals.sqlite3
AGENT_DISABLE_LLM=0
AGENT_INPUT_CNY_PER_1K=0.001
AGENT_OUTPUT_CNY_PER_1K=0.002
AGENT_REQUEST_TOKEN_BUDGET=1000
